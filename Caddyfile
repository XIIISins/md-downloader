{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	handle /healthz {
		respond "ok" 200
	}

	# The Go service serves these; everything else is static.
	@backend path /api/* /cover/*
	handle @backend {
		reverse_proxy {$API_UPSTREAM:md-downloader-api:8080}
	}

	handle {
		root * /srv
		encode zstd gzip
		file_server
	}
}
